# ==========================================
# DisasterNet - Twilio SMS Configuration
# ==========================================
# To send real SMS to mobile phones, fill in your Twilio account details:
# 1. Sign up / log in to Twilio (https://www.twilio.com/console)
# 2. Copy your Account SID and Auth Token
# 3. Get a Twilio phone number (e.g. +1234567890)
#
# If left blank, SMS notifications & OTPs will automatically fall back
# to console logging in your terminal.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# ==========================================
# SSLCOMMERZ Sandbox Configuration
# ==========================================
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_FRONTEND_URL=http://127.0.0.1:5173
SSLCOMMERZ_CALLBACK_BASE_URL=
